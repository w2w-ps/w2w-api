        {
          "name": "No Shift Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pre-check returns OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('response has conflict envelope', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('hasConflicts');",
                  "  pm.expect(json).to.have.property('conflicts');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": 1,\n  \"operationType\": \"CREATE\",\n  \"shift\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
