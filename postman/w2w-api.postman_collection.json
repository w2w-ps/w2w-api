            "url": "{{baseUrl}}/api/scheduling/shifts/{{shiftId}}"
          }
        },
        {
          "name": "Employee View - /shifts/employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns employees with grouped day buckets relative to the requested startDate. Each bucket contains a date and its shifts; availablePositions are returned as id/name objects. Preferred path: /api/scheduling/shifts/employees. The legacy /api/scheduling/employees path is deprecated.",
            "url": "{{baseUrl}}/api/scheduling/shifts/employees?companyId={{companyId}}&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Position View - /shifts/date-position",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns date buckets for the requested range, with each date grouped by position and each position listing employee-level shift entries. All company positions are included even when a given date has no shifts for them. Each date includes shiftCount and totalDuration, and each position bucket includes its own shiftCount and totalDuration.",
            "url": "{{baseUrl}}/api/scheduling/shifts/date-position?companyId={{companyId}}&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Calendar View - Position Shift Timings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns the normalized grouped response. Results are always grouped by date first under dates[], then by position and shift timing under nested shiftGroups[].",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=position_shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Calendar View - Shift Timings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns the normalized grouped response. Results are always grouped by date first under dates[], then directly by shift timing under shiftGroups[].",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Calendar View - Category Shift Timings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns the normalized grouped response. Results are always grouped by date first under dates[], then by category and shift timing under nested shiftGroups[].",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=category_shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Calendar View - Category Short Name Shift Timings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns the normalized grouped response. Results are always grouped by date first under dates[], then by category short description and shift timing under nested shiftGroups[].",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=cat_shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        }
      ]
