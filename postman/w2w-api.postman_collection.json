          }
        },
        {
          "name": "Update Shift",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-03-31\",\n  \"description\": \"Updated opening shift\",\n  \"startTime\": \"10:00AM\",\n  \"endTime\": \"6:00PM\",\n  \"position\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/scheduling/shifts/{{shiftId}}"
          }
        },
        {
          "name": "Delete Shift (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/scheduling/shifts/{{shiftId}}"
          }
        },
        {
          "name": "Get Grouped Shifts In Range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns employees with grouped day buckets relative to the requested startDate. Each bucket contains a date and its shifts; availablePositions are returned as id/name objects. Preferred path: /api/scheduling/shifts/employees. The legacy /api/scheduling/employees path is deprecated.",
            "url": "{{baseUrl}}/api/scheduling/shifts/employees?companyId={{companyId}}&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Day And Position",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns day buckets for the requested range, with each day grouped by position and each position listing employee-level shift entries. All company positions are included even when a given day has no shifts for them. Each day includes shiftCount and totalDuration, and each position bucket includes its own shiftCount and totalDuration.",
            "url": "{{baseUrl}}/api/scheduling/shifts/day-position?companyId={{companyId}}&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Selector (Day Position)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns the same day-position bucket payload as /api/scheduling/shifts/day-position, selected through the grouped endpoint via grouping=position.",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=position&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Day Position And Timing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns day buckets for the requested range, with each day grouped by position and then by shift timing. Each timing bucket lists employee-level shift entries. All company positions are included even when a given day has no shifts for them. Each day, position bucket, and timing bucket includes shiftCount and totalDuration.",
            "url": "{{baseUrl}}/api/scheduling/shifts/day-position-timing?companyId={{companyId}}&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Selector (Day Position Shift Timings)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns day-position-shift-timing buckets through the grouped endpoint via grouping=position_shift_timings.",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=position_shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Selector (Day Shift Timings)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns day-shift-timing buckets through the grouped endpoint via grouping=shift_timings. This payload does not include aggregate shift counts or durations.",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        },
        {
          "name": "Get Grouped Shifts By Selector (Day Category Shift Timings)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "description": "Returns day-category-shift-timing buckets through the grouped endpoint via grouping=category_shift_timings. This payload does not include aggregate shift counts or durations.",
            "url": "{{baseUrl}}/api/scheduling/shifts/grouped?companyId={{companyId}}&grouping=category_shift_timings&startDate={{startDate}}&endDate={{endDate}}"
          }
        }
      ]
    },
